# EchoFlowSiHub Desktop — Windows packaging environment.
#
# Copied to apps/desktop/.env.windows by build-desktop.sh before packaging.
# Upstream requires this file to exist even for unsigned builds.
#
# Unsigned: every signing field below stays empty, which is what
# `--unsigned` expects. The mandatory-update origin is required either way.

# Our own app id, not upstream's. This is what the installer registers and
# what the per-user data directory is scoped to, so it also decides that an
# EchoFlowSiHub install and a DeepSeek Harness install coexist.
DSH_DESKTOP_APP_ID=cc.echoflowai.sihub

# `test` keeps the updater off the production channel while there is no
# release feed of our own yet; switch to `prod` when one exists.
DSH_DESKTOP_AUTO_UPDATE_ENV=test

# The mandatory-update page. Upstream requires an origin here for every
# build, signed or not. Until we host our own, the station's own site is the
# honest answer: it is where a user would be told to download the new build.
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=https://api.echoflowai.cc
DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=https://api.echoflowai.cc
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG={"allowedAuthOrigins":["https://api.echoflowai.cc"]}

# Signing: none. An unsigned installer is what this repository produces
# today; Windows will show a SmartScreen prompt on first run.
DSH_DESKTOP_WINDOWS_CER_FILE=
DSH_DESKTOP_WINDOWS_SIGNTOOL=
DSH_DESKTOP_WINDOWS_KEY_CONTAINER=
DSH_DESKTOP_WINDOWS_TOKEN_PIN=

# The bundled runtime installs from npm; the mirror is faster from China and
# the packages are the same ones the public registry carries.
DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com
